{
  "manifest_version": 3,
  "name": "Buying Board",
  "version": "1.0.0",
  "description": "Keep track of items you plan to buy on Amazon",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["config.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Buying Board"
  }
}

